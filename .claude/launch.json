{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "erp",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "erp-demo",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "PATH=$HOME/.local/node22/bin:$PATH NEXT_PUBLIC_SUPABASE_URL= NEXT_PUBLIC_SUPABASE_ANON_KEY= UPI_VPA=demo-institute@upi npm --prefix web run dev -- -p 3005"
      ],
      "port": 3005
    },
    {
      "name": "website",
      "runtimeExecutable": "node",
      "runtimeArgs": ["website/serve.mjs", "4321"],
      "port": 4321
    }
  ]
}