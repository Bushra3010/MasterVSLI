{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mastervlsi-erp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Secrets (SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET, ZOOM_WEBHOOK_SECRET, BIOMETRIC_API_KEY,
  // TEAMVIEWER_API_KEY, GOOGLE_SERVICE_ACCOUNT_JSON, GOOGLE_SHEET_ID) go in via `wrangler secret put`.
  // Optional var APP_URL pins the domain used in certificate QR codes.
  "vars": {}
}
