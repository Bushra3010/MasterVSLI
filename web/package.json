{
  "name": "mastervlsi-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "export XDG_CONFIG_HOME=$HOME/.config/mastervlsi; opennextjs-cloudflare build && opennextjs-cloudflare preview",
