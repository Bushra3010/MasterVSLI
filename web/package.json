    "cf-typegen": "export XDG_CONFIG_HOME=$HOME/.config/mastervlsi; wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "postinstall": "node scripts/patch-opennext-cookie.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
