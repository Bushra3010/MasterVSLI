# --- Supabase (leave blank to run in built-in DEMO mode) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_URL=                      # optional: domain used in certificate QR codes (defaults to the request host)
CRON_SECRET=change-me

# --- Attendance integrations ---
ZOOM_WEBHOOK_SECRET=          # Zoom app "Secret Token" (event subscriptions)
TEAMVIEWER_API_KEY=           # shared key the recording/LMS bridge sends as x-api-key
BIOMETRIC_API_KEY=            # shared key biometric devices/bridge send as x-api-key

# --- Google Sheets sync for placement drives ---
GOOGLE_SERVICE_ACCOUNT_JSON=  # full JSON of a service account with Sheets access
GOOGLE_SHEET_ID=              # default spreadsheet; each drive gets its own tab
